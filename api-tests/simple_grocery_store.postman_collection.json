                  "const responseData = pm.response.json();\r\n\r\npm.test(\"Access request is unauthorized, Status code is 401\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"Authorization error message is returned in the response body\", function () {\r\n    pm.expect(responseData.error).to.exist;\r\n    pm.expect(responseData.error.toLowerCase()).to.include(\"missing\");\r\n});"
